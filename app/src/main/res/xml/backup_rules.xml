<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 y anteriores. allowBackup="false" ya desactiva las copias; además se
     excluye todo por si alguna vez se activan: tokens cifrados y hash del PIN no se copian. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
