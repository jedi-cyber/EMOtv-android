# Reglas de R8 para la versión final de EMOtv. AGP combina todos los archivos de
# src/main/keepRules. Retrofit, OkHttp, kotlinx.serialization y AndroidX traen sus propias
# reglas; aquí solo va lo propio del aplicativo.

# Ningún registro de depuración en la versión final: R8 elimina las llamadas a Log
# (también las de las bibliotecas) y el texto que se arma para ellas.
-assumenosideeffects class android.util.Log {
    public static boolean isLoggable(java.lang.String, int);
    public static int v(...);
    public static int d(...);
    public static int i(...);
    public static int w(...);
    public static int e(...);
    public static int wtf(...);
    public static int println(int, java.lang.String, java.lang.String);
    public static java.lang.String getStackTraceString(java.lang.Throwable);
}

# Las bibliotecas que preguntan antes de registrar (OkHttp, CameraX) reciben siempre «no»,
# así R8 elimina también esas ramas.
-assumevalues class android.util.Log {
    public static boolean isLoggable(java.lang.String, int) return false;
}

# Los nombres de clases y métodos se ofuscan; las trazas de un fallo solo se pueden leer
# con el mapping.txt de esa compilación, que no se publica.
-renamesourcefileattribute SourceFile
