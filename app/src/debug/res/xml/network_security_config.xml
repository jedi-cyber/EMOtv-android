<?xml version="1.0" encoding="utf-8"?>
<!-- Solo depuración: permite HTTP para el servidor local de desarrollo
     (emotv.apiUrl.debug en local.properties). La versión final no incluye este archivo. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
